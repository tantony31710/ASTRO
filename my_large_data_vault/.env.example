# Copy this file to `.env` and fill in the values you use.
# `.env` is gitignored — your keys never land in the repo.
#
# LLM backends (routing: Anthropic > OpenAI > local)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Local Llama-3 inference (requires a GGUF weights file and
# `pip install llama-cpp-python`)
# JARVIS_LLM_BACKEND=local
# JARVIS_LOCAL_MODEL=./model_weights/Meta-Llama-3-8B-Instruct-Q4_K_M.gguf
#
# Voice (STT backend: "google" | "whisper")
# JARVIS_STT_BACKEND=google
#
# Wake-word mode (JARVIS_MODE=wake in .env or on the command line).
# "jarvis" is matched case-insensitively; common misrecognitions are
# tolerated automatically (jervis, garvis, ...). Set your own keyword:
# JARVIS_MODE=wake
# JARVIS_WAKE_WORD=jarvis
# JARVIS_WAKE_THRESHOLD=0.6
#
# TTS voice — default is the British "en-GB-RyanNeural" (the JARVIS sound).
# Any edge-tts voice works: `edge-tts --list-voices`
# JARVIS_TTS_VOICE=en-GB-RyanNeural
#
# No API credits? No problem. If an API key is set but the provider
# rejects the call ("credit balance is too low", rate limits, quota),
# JARVIS automatically falls back to the local Llama-3 backend — as long
# as JARVIS_LLM_BACKEND=local and JARVIS_LOCAL_MODEL point at a GGUF file.
# To work fully offline, leave both API key lines commented out and set
# the local backend above.
