# Copy this file to `.env` and fill in the values you use.
# `.env` is gitignored — your keys never land in the repo.
#
# LLM backends (routing: Anthropic > OpenAI > local)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Local Llama-3 inference (requires a GGUF weights file and
# `pip install llama-cpp-python`)
# JARVIS_LLM_BACKEND=local
# JARVIS_LOCAL_MODEL=./model_weights/Meta-Llama-3-8B-Instruct-Q4_K_M.gguf
#
# Voice (STT backend: "google" | "whisper")
# JARVIS_STT_BACKEND=google
